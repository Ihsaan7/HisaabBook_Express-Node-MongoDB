<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hisaab Detail</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Optional: Modern Font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>
<body>
  <nav class="w-full py-4 px-6 shadow-[0_4px_6px_-1px_rgba(0,0,0,0.1)] flex items-center justify-between border-b border-gray-200">
    <h2 class="text-black text-xl font-semibold">Khaatabook</h2>
    <div class="flex gap-5 items-center text-black">
      <a href="/">Home</a>
      <% if (isOwner) { %>
        <a href="/create/<%= userUId %>">Create New Hisaab</a>
        <a href="/show/<%= userUId %>">My Hisaabs</a>
      <% } %>
    </div>
  </nav>

  <div>
    <div class="border flex justify-center py-5">
      <h1 class="text-xl text-blue-600">
        Showing the Hisaab of <%= hisaabId.nameDate %>
      </h1>
    </div>
    <div class="border mt-5">
      <div class="flex justify-around">
        <% if (hisaabId.encrypt === true) { %>
          <p class="border w-fit p-2"><span>⛔</span> Encrypted</p>
        <% } else { %>
          <p class="border w-fit p-2"><span>⏹️</span> Open</p>
        <% } %>
        <% if (hisaabId.isShare) { %>
          <button 
            onclick="shareHisaab('<%= hisaabId._id %>', '<%= hisaabId.topic %>')"
            class="border w-fit p-2 bg-blue-500 text-white hover:bg-blue-600 cursor-pointer">
            <span>📤</span> Share
          </button>
        <% } else { %>
          <p class="border w-fit p-2 bg-gray-300 text-gray-500"><span>🔒</span> Not Shareable</p>
        <% } %>
        <% if (isOwner) { %>
          <a href="/delete/<%= hisaabId._id %>"><button class="border p-2 bg-red-500 text-white hover:bg-red-600">Delete</button></a>
          <a href="/update/<%= hisaabId._id %>"><button class="border p-2 bg-green-500 text-white hover:bg-green-600">Update</button></a>
        <% } %>
      </div>
      <p class="border w-fit ml-4 mt-2 px-2 text-sm text-gray-300">
        Created on <%= hisaabId?.nameDate || 'Unknown' %>
      </p>
      <div class="flex flex-col mt-10 w-[80%] mx-auto">
      <% if (hisaabId?.encrypt) { %>
        <% if (typeof flag !== 'undefined') { %>
          <% if (flag === '1') { %>
            <p class="border pl-5 py-5 my-0">
              <%= hisaabId?.data || '(No data available)' %>
            </p>
          <% } else { %>
            <p class="border pl-5 py-5 my-0 text-red-600">Wrong Passcode, Enter again!</p>
          <% } %>
        <% } else { %>
          <p class="text-red-600">Enter the password to view the data</p>
          <form action="/showDetail/<%= hisaabId._id %>" method="POST">
            <input 
              type="password" 
              name="encPass" 
              class="border p-2 mt-2 w-full" 
              placeholder="Enter password" 
              required 
            />
            <button type="submit" class="border p-2 mt-2 bg-blue-600 text-white">
              Unlock
            </button>
          </form>
        <% } %>
      <% } else { %>
        <p class="border pl-5 py-5 my-0">
          <%= hisaabId?.data || '(No data available)' %>
        </p>
      <% } %>
      </div>
    </div>
  </div>

  <script>
    function shareHisaab(hisaabId, topic) {
      const shareUrl = `${window.location.origin}/showDetail/${hisaabId}`;
      const shareData = {
        title: `Hisaab: ${topic}`,
        text: `Check out this hisaab: ${topic}`,
        url: shareUrl
      };

      // Check if Web Share API is supported
      if (navigator.share) {
        navigator.share(shareData)
          .then(() => console.log('Hisaab shared successfully'))
          .catch((error) => {
            console.log('Error sharing:', error);
            fallbackShare(shareUrl, topic);
          });
      } else {
        // Fallback for browsers that don't support Web Share API
        fallbackShare(shareUrl, topic);
      }
    }

    function fallbackShare(url, topic) {
      // Copy to clipboard as fallback
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url)
          .then(() => {
            alert(`Link copied to clipboard!\n\nHisaab: ${topic}\nLink: ${url}`);
          })
          .catch(() => {
            // Manual copy fallback
            showShareDialog(url, topic);
          });
      } else {
        showShareDialog(url, topic);
      }
    }

    function showShareDialog(url, topic) {
      const shareText = `Hisaab: ${topic}\nLink: ${url}`;
      prompt('Copy this link to share:', url);
    }
  </script>
</body>
</html>