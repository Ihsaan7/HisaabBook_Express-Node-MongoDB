<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hisaab Detail - Khaatabook</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="/css/styles.css" rel="stylesheet" />
  <style>
    .detail-container {
      min-height: calc(100vh - 80px);
      padding: var(--spacing-8) 0;
      background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
    }
    .detail-card {
      background: var(--bg-card);
      border-radius: var(--radius-xl);
      padding: var(--spacing-8);
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--border-primary);
      margin-bottom: var(--spacing-6);
    }
    .detail-header {
      text-align: center;
      margin-bottom: var(--spacing-8);
      padding-bottom: var(--spacing-6);
      border-bottom: 1px solid var(--border-primary);
    }
    .detail-title {
      font-size: var(--font-size-2xl);
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: var(--spacing-2);
    }
    .detail-subtitle {
      color: var(--text-secondary);
      font-size: var(--font-size-sm);
    }
    .status-section {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-4);
      margin-bottom: var(--spacing-6);
      justify-content: center;
    }
    .status-badge {
      padding: var(--spacing-2) var(--spacing-4);
      border-radius: var(--radius-lg);
      font-size: var(--font-size-sm);
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: var(--spacing-2);
    }
    .status-encrypted {
      background: var(--warning-light);
      color: var(--warning-color);
    }
    .status-open {
      background: var(--success-light);
      color: var(--success-color);
    }
    .actions-section {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-3);
      justify-content: center;
      margin-bottom: var(--spacing-6);
    }
    .content-section {
      background: var(--bg-card);
      border-radius: var(--radius-lg);
      padding: var(--spacing-6);
      border: 1px solid var(--border-primary);
      line-height: 1.6;
    }
    .unlock-form {
      background: var(--bg-card);
      border-radius: var(--radius-lg);
      padding: var(--spacing-6);
      border: 1px solid var(--border-primary);
      text-align: center;
    }
    .unlock-icon {
      font-size: 3rem;
      margin-bottom: var(--spacing-4);
      opacity: 0.7;
    }
    @media (max-width: 768px) {
      .status-section {
        flex-direction: column;
        align-items: center;
      }
      .actions-section {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar">
    <div class="navbar-container">
      <div class="navbar-content">
        <a href="/" class="navbar-brand">
          <span class="brand-icon">📚</span>
          <span class="brand-text">Khaatabook</span>
        </a>
        <div class="navbar-nav">
          <a href="/" class="navbar-link">Home</a>
          <% if (isOwner) { %>
            <a href="/create/<%= userUId %>" class="btn btn-primary btn-sm">
              <span>➕</span> Create New
            </a>
            <a href="/show/<%= userUId %>" class="navbar-link">My Hisaabs</a>
          <% } %>
          <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
            <span class="theme-icon">🌙</span>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <div class="detail-container">
    <div class="container">
      <!-- Header -->
      <div class="detail-card fade-in">
        <div class="detail-header">
          <h1 class="detail-title"><%= hisaabId.topic || 'Untitled Hisaab' %></h1>
          <p class="detail-subtitle">
            📅 Created on <%= hisaabId?.nameDate || 'Unknown' %>
          </p>
        </div>

        <!-- Status Section -->
        <div class="status-section">
          <% if (hisaabId.encrypt === true) { %>
            <div class="status-badge status-encrypted">
              <span>🔒</span> Encrypted
            </div>
          <% } else { %>
            <div class="status-badge status-open">
              <span>🔓</span> Open
            </div>
          <% } %>
          
          <% if (hisaabId.isShare) { %>
            <div class="status-badge" style="background: var(--info-light); color: var(--info-color);">
              <span>🔗</span> Shareable
            </div>
          <% } else { %>
            <div class="status-badge" style="background: var(--bg-secondary); color: var(--text-secondary);">
              <span>🔒</span> Private
            </div>
          <% } %>
        </div>

        <% 
        // Show buttons only if:
        // 1. Hisaab is not encrypted, OR
        // 2. Hisaab is encrypted but unlocked (flag === '1')
        const showButtons = !hisaabId.encrypt || (hisaabId.encrypt && flag === '1');
        %>
        
        <!-- Actions Section -->
        <% if (showButtons) { %>
          <div class="actions-section">
            <% if (hisaabId.isShare) { %>
              <button 
                onclick="shareHisaab('<%= hisaabId._id %>', '<%= hisaabId.topic %>')"
                class="btn btn-secondary">
                <span>📤</span> Share Hisaab
              </button>
            <% } %>
            
            <% if (isOwner) { %>
              <a href="/update/<%= hisaabId._id %>" class="btn btn-primary">
                <span>✏️</span> Edit
              </a>
              <a href="/delete/<%= hisaabId._id %>" class="btn btn-danger" 
                 onclick="return confirm('Are you sure you want to delete this hisaab? This action cannot be undone.')">
                <span>🗑️</span> Delete
              </a>
            <% } %>
            
            <a href="/show/<%= userUId || '' %>" class="btn btn-outline">
              <span>⬅️</span> Back to List
            </a>
          </div>
        <% } else { %>
          <div class="actions-section">
            <div class="status-badge" style="background: var(--warning-light); color: var(--warning-color);">
              <span>🔒</span> Unlock to access options
            </div>
          </div>
        <% } %>
      </div>

      <!-- Content Section -->
      <div class="fade-in">
        <% if (hisaabId?.encrypt) { %>
          <% if (typeof flag !== 'undefined') { %>
            <% if (flag === '1') { %>
              <div class="content-section">
                <h3 style="font-size: var(--font-size-lg); font-weight: 600; color: var(--text-primary); margin-bottom: var(--spacing-4);">
                  📄 Hisaab Details
                </h3>
                <div style="color: var(--text-primary); white-space: pre-wrap;">
                  <%= hisaabId?.data || '(No data available)' %>
                </div>
              </div>
            <% } else { %>
              <div class="unlock-form">
                <div class="unlock-icon">❌</div>
                <h3 style="font-size: var(--font-size-lg); font-weight: 600; color: var(--danger-color); margin-bottom: var(--spacing-4);">
                  Incorrect Password
                </h3>
                <p style="color: var(--text-secondary); margin-bottom: var(--spacing-6);">
                  The password you entered is incorrect. Please try again.
                </p>
                <form action="/showDetail/<%= hisaabId._id %>" method="POST" class="form-group" id="passwordForm">
                  <input 
                    type="password" 
                    name="encPass" 
                    class="form-input" 
                    placeholder="Enter password" 
                    required 
                    autofocus
                    id="passwordInput"
                  />
                  <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: var(--spacing-4);" id="unlockBtn">
                    <span id="unlockIcon">🔓</span> <span id="unlockText">Unlock Hisaab</span>
                  </button>
                </form>
              </div>
            <% } %>
          <% } else { %>
            <div class="unlock-form">
              <div class="unlock-icon">🔐</div>
              <h3 style="font-size: var(--font-size-lg); font-weight: 600; color: var(--text-primary); margin-bottom: var(--spacing-4);">
                This Hisaab is Protected
              </h3>
              <p style="color: var(--text-secondary); margin-bottom: var(--spacing-6);">
                Enter the password to view the contents of this hisaab.
              </p>
              <form action="/showDetail/<%= hisaabId._id %>" method="POST" class="form-group" id="initialPasswordForm">
                <input 
                  type="password" 
                  name="encPass" 
                  class="form-input" 
                  placeholder="Enter password" 
                  required 
                  autofocus
                  id="initialPasswordInput"
                />
                <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: var(--spacing-4);" id="initialUnlockBtn">
                  <span id="initialUnlockIcon">🔓</span> <span id="initialUnlockText">Unlock Hisaab</span>
                </button>
              </form>
            </div>
          <% } %>
        <% } else { %>
          <div class="content-section">
            <h3 style="font-size: var(--font-size-lg); font-weight: 600; color: var(--text-primary); margin-bottom: var(--spacing-4);">
              📄 Hisaab Details
            </h3>
            <div style="color: var(--text-primary); white-space: pre-wrap;">
              <%= hisaabId?.data || '(No data available)' %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <script src="/js/theme.js"></script>

  <script>
    function shareHisaab(hisaabId, topic) {
      const shareUrl = `${window.location.origin}/showDetail/${hisaabId}`;
      const shareData = {
        title: `Hisaab: ${topic}`,
        text: `Check out this hisaab: ${topic}`,
        url: shareUrl
      };

      // Check if Web Share API is supported
      if (navigator.share) {
        navigator.share(shareData)
          .then(() => {
            showNotification('Hisaab shared successfully! 📤', 'success');
          })
          .catch((error) => {
            console.log('Error sharing:', error);
            fallbackShare(shareUrl, topic);
          });
      } else {
        // Fallback for browsers that don't support Web Share API
        fallbackShare(shareUrl, topic);
      }
    }

    function fallbackShare(url, topic) {
      // Copy to clipboard as fallback
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url)
          .then(() => {
            showNotification(`Link copied to clipboard! 📋\n\nShare this link: ${url}`, 'success');
          })
          .catch(() => {
            // Manual copy fallback
            showShareDialog(url, topic);
          });
      } else {
        showShareDialog(url, topic);
      }
    }

    function showShareDialog(url, topic) {
      prompt('Copy this link to share:', url);
    }

    function showNotification(message, type = 'info') {
      // Create notification element
      const notification = document.createElement('div');
      notification.style.cssText = `
        position: fixed;
        top: 20px;
        right: 20px;
        background: ${type === 'success' ? 'var(--success-color)' : type === 'error' ? 'var(--danger-color)' : 'var(--info-color)'};
        color: white;
        padding: var(--spacing-4) var(--spacing-6);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        z-index: 1000;
        max-width: 300px;
        font-size: var(--font-size-sm);
        line-height: 1.4;
        white-space: pre-line;
      `;
      notification.textContent = message;
      
      document.body.appendChild(notification);
      
      // Remove after 4 seconds
      setTimeout(() => {
        if (notification.parentNode) {
          notification.parentNode.removeChild(notification);
        }
      }, 4000);
    }

    // Handle password form submissions with loading states
    function handlePasswordForm(formId, btnId, iconId, textId) {
      const form = document.getElementById(formId);
      const btn = document.getElementById(btnId);
      const icon = document.getElementById(iconId);
      const text = document.getElementById(textId);
      
      if (form && btn && icon && text) {
        form.addEventListener('submit', function(e) {
          // Show loading state
          btn.disabled = true;
          btn.style.opacity = '0.7';
          icon.textContent = '⏳';
          text.textContent = 'Verifying...';
          
          // Show notification
          showNotification('Verifying password...', 'info');
          
          // Set a timeout to re-enable the button in case of issues
          setTimeout(() => {
            if (btn.disabled) {
              btn.disabled = false;
              btn.style.opacity = '1';
              icon.textContent = '🔓';
              text.textContent = 'Unlock Hisaab';
              showNotification('Request timed out. Please try again.', 'error');
            }
          }, 10000); // 10 second timeout
        });
      }
    }

    // Initialize password form handlers when page loads
    document.addEventListener('DOMContentLoaded', function() {
      handlePasswordForm('passwordForm', 'unlockBtn', 'unlockIcon', 'unlockText');
      handlePasswordForm('initialPasswordForm', 'initialUnlockBtn', 'initialUnlockIcon', 'initialUnlockText');
      
      // Show error notification if password was incorrect
      <% if (typeof flag !== 'undefined' && flag === '0') { %>
        showNotification('❌ Incorrect password entered. Please try again.', 'error');
      <% } %>
    });
  </script>
</body>
</html>