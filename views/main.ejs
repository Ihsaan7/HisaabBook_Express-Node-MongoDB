<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Khaatabook - Manage Your Hisaabs</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
    <style>
        .hero-gradient {
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
        }
        .feature-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-xl);
            font-size: 24px;
            margin-bottom: var(--spacing-4);
        }
    </style>
</head>

<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <div class="navbar-content">
                <a href="/" class="navbar-brand">
                    <span style="margin-right: 8px;">📊</span>Khaatabook
                </a>
                <div class="navbar-nav">
                    <% if (isLoggedIn) { %>
                        <a href="/show/<%= userId %>" class="navbar-link">My Hisaabs</a>
                        <a href="/create/<%= userId %>" class="btn btn-primary btn-sm">Create New</a>
                        <a href="/logout" class="navbar-link" style="color: var(--danger-color);">Logout</a>
                    <% } else { %>
                        <a href="/login" class="navbar-link">Login</a>
                        <a href="/signUp" class="btn btn-primary btn-sm">Sign Up</a>
                    <% } %>
                    <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
                        <span class="theme-icon">🌙</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-gradient" style="padding: var(--spacing-16) 0;">
        <div class="container">
            <div class="text-center" style="margin-bottom: var(--spacing-16);">
                <h1 style="font-size: var(--font-size-4xl); font-weight: 700; margin-bottom: var(--spacing-6); line-height: 1.2;">
                    Manage Your <span style="color: var(--primary-color);">Hisaabs</span> Effortlessly
                </h1>
                <p style="font-size: var(--font-size-xl); color: var(--text-secondary); margin-bottom: var(--spacing-8); max-width: 600px; margin-left: auto; margin-right: auto;">
                    Keep track of your financial records, share them securely, and manage your accounts with ease. 
                    Your digital ledger for modern financial management.
                </p>
                
                <% if (!isLoggedIn) { %>
                    <div class="flex justify-center gap-4" style="flex-wrap: wrap;">
                        <a href="/signUp" class="btn btn-primary btn-lg">
                            <span>🚀</span> Get Started Free
                        </a>
                        <a href="/login" class="btn btn-secondary btn-lg">
                            <span>🔑</span> Login
                        </a>
                    </div>
                <% } else { %>
                    <div class="flex justify-center gap-4" style="flex-wrap: wrap;">
                        <a href="/create/<%= userId %>" class="btn btn-primary btn-lg">
                            <span>➕</span> Create New Hisaab
                        </a>
                        <a href="/show/<%= userId %>" class="btn btn-secondary btn-lg">
                            <span>📋</span> View My Hisaabs
                        </a>
                    </div>
                <% } %>
            </div>

            <!-- Features Section -->
            <div class="grid grid-cols-3" style="margin-top: var(--spacing-16);">
                <div class="card fade-in">
                    <div class="card-body">
                        <div class="feature-icon" style="background-color: var(--primary-light); color: var(--primary-color);">
                            📝
                        </div>
                        <h3 style="font-size: var(--font-size-xl); font-weight: 600; margin-bottom: var(--spacing-3);">Easy Record Keeping</h3>
                        <p>Create and manage your financial records with our intuitive interface. Add details, dates, and organize everything efficiently.</p>
                    </div>
                </div>
                
                <div class="card fade-in" style="animation-delay: 0.1s;">
                    <div class="card-body">
                        <div class="feature-icon" style="background-color: #dcfce7; color: var(--success-color);">
                            🔗
                        </div>
                        <h3 style="font-size: var(--font-size-xl); font-weight: 600; margin-bottom: var(--spacing-3);">Secure Sharing</h3>
                        <p>Share your hisaabs securely with others. Control who can view and edit your records with advanced permission settings.</p>
                    </div>
                </div>
                
                <div class="card fade-in" style="animation-delay: 0.2s;">
                    <div class="card-body">
                        <div class="feature-icon" style="background-color: #fef3c7; color: var(--warning-color);">
                            🔒
                        </div>
                        <h3 style="font-size: var(--font-size-xl); font-weight: 600; margin-bottom: var(--spacing-3);">Privacy Protection</h3>
                        <p>Encrypt sensitive data with secret codes. Your financial information stays private and secure at all times.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer style="background-color: var(--bg-card); border-top: 1px solid var(--border-primary); margin-top: var(--spacing-16);">
        <div class="container" style="padding: var(--spacing-8) 0;">
            <div class="text-center">
                <p style="color: var(--text-secondary); margin: 0;">
                    &copy; 2025 Khaatabook. Built with ❤️ by Ihsaan.
                </p>
            </div>
        </div>
    </footer>

    <script src="/js/theme.js"></script>
</body>

</html>