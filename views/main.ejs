<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Khaatabook - Manage Your Hisaabs</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>

<body class="bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen">
    <!-- Navigation -->
    <nav class="w-full py-4 px-6 bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <h2 class="text-2xl font-bold text-blue-600">📊 Khaatabook</h2>
            <div class="flex gap-4 items-center">
                <% if (isLoggedIn) { %>
                    <a href="/show/<%= userId %>" class="text-gray-700 hover:text-blue-600 transition-colors">My Hisaabs</a>
                    <a href="/create/<%= userId %>" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">Create New</a>
                    <a href="/logout" class="text-gray-500 hover:text-red-600 transition-colors">Logout</a>
                <% } else { %>
                    <a href="/login" class="text-gray-700 hover:text-blue-600 transition-colors">Login</a>
                    <a href="/signUp" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">Sign Up</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-6 py-16">
        <div class="text-center mb-16">
            <h1 class="text-5xl font-bold text-gray-900 mb-6">
                Manage Your <span class="text-blue-600">Hisaabs</span> Effortlessly
            </h1>
            <p class="text-xl text-gray-600 mb-8 max-w-3xl mx-auto">
                Keep track of your financial records, share them securely, and manage your accounts with ease. 
                Your digital ledger for modern financial management.
            </p>
            
            <% if (!isLoggedIn) { %>
                <div class="flex gap-4 justify-center">
                    <a href="/signUp" class="bg-blue-600 text-white px-8 py-3 rounded-lg text-lg font-semibold hover:bg-blue-700 transition-colors shadow-lg">
                        Get Started Free
                    </a>
                    <a href="/login" class="border-2 border-blue-600 text-blue-600 px-8 py-3 rounded-lg text-lg font-semibold hover:bg-blue-50 transition-colors">
                        Login
                    </a>
                </div>
            <% } else { %>
                <div class="flex gap-4 justify-center">
                    <a href="/create/<%= userId %>" class="bg-blue-600 text-white px-8 py-3 rounded-lg text-lg font-semibold hover:bg-blue-700 transition-colors shadow-lg">
                        Create New Hisaab
                    </a>
                    <a href="/show/<%= userId %>" class="border-2 border-blue-600 text-blue-600 px-8 py-3 rounded-lg text-lg font-semibold hover:bg-blue-50 transition-colors">
                        View My Hisaabs
                    </a>
                </div>
            <% } %>
        </div>

        <!-- Features Section -->
        <div class="grid md:grid-cols-3 gap-8 mt-16">
            <div class="bg-white p-8 rounded-xl shadow-lg border border-gray-100">
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
                    <i class="ri-file-list-3-line text-2xl text-blue-600"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-3">Easy Record Keeping</h3>
                <p class="text-gray-600">Create and manage your financial records with our intuitive interface. Add details, dates, and organize everything efficiently.</p>
            </div>
            
            <div class="bg-white p-8 rounded-xl shadow-lg border border-gray-100">
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-4">
                    <i class="ri-share-line text-2xl text-green-600"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-3">Secure Sharing</h3>
                <p class="text-gray-600">Share your hisaabs securely with others. Control who can view and edit your records with advanced permission settings.</p>
            </div>
            
            <div class="bg-white p-8 rounded-xl shadow-lg border border-gray-100">
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
                    <i class="ri-lock-line text-2xl text-purple-600"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-3">Privacy Protection</h3>
                <p class="text-gray-600">Encrypt sensitive data with secret codes. Your financial information stays private and secure at all times.</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 mt-16">
        <div class="max-w-7xl mx-auto px-6 py-8">
            <div class="text-center text-gray-600">
                <p>&copy; 2024 Khaatabook. Built with ❤️ for better financial management.</p>
            </div>
        </div>
    </footer>
</body>

</html>