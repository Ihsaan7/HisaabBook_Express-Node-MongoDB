<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Update Hisaab - Khaatabook</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="/css/styles.css" rel="stylesheet" />
  <style>
    .update-container {
      min-height: calc(100vh - 80px);
      padding: var(--spacing-8) 0;
      background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
    }
    .update-card {
      max-width: 800px;
      margin: 0 auto;
      background: var(--bg-card);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--border-primary);
      padding: var(--spacing-8);
    }
    .update-header {
      text-align: center;
      margin-bottom: var(--spacing-8);
    }
    .update-title {
      font-size: var(--font-size-2xl);
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: var(--spacing-2);
    }
    .permissions-section {
      background: var(--bg-secondary);
      border-radius: var(--radius-lg);
      padding: var(--spacing-6);
      border: 1px solid var(--border-secondary);
    }
    .permission-item {
      display: flex;
      align-items: center;
      gap: var(--spacing-3);
      padding: var(--spacing-3);
      border-radius: var(--radius-md);
      transition: background-color 0.2s ease;
    }
    .permission-item:hover {
      background: var(--bg-card);
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar">
    <div class="container">
      <div class="navbar-content">
        <a href="/" class="navbar-brand">
          <span style="margin-right: 8px;">📊</span>Khaatabook
        </a>
        <div class="navbar-nav">
          <a href="/" class="navbar-link">Home</a>
          <a href="/create/<%= hisaabData.userId %>" class="navbar-link">Create New Hisaab</a>
          <a href="/logout" class="navbar-link" style="color: var(--danger-color);">Logout</a>
          <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
            <span class="theme-icon">🌙</span>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <div class="update-container">
    <div class="container">
      <div class="update-card fade-in">
        <div class="update-header">
          <h1 class="update-title">✏️ Update Hisaab</h1>
          <p style="color: var(--text-secondary); font-size: var(--font-size-base);">Editing: <strong><%= hisaabData.topic %></strong></p>
        </div>

        <form action="/update/<%= hisaabData._id %>" method="post" class="form" id="update-form">
          <!-- Title Field -->
          <div class="form-group">
            <label for="title" class="form-label">
              <span>📋</span> Title
            </label>
            <input 
              type="text" 
              name="title" 
              id="title" 
              class="form-input" 
              placeholder="Enter a descriptive title for your hisaab"
              value="<%= hisaabData.topic %>"
              required 
            />
          </div>

          <!-- Details Textarea -->
          <div class="form-group">
            <label for="hisaab" class="form-label">
              <span>📄</span> Details
            </label>
            <textarea 
              name="hisaab" 
              id="hisaab" 
              class="form-textarea" 
              rows="8"
              placeholder="Write your hisaab details here... Include amounts, dates, descriptions, or any relevant information."
              required
            ><%= hisaabData.data %></textarea>
          </div>

          <!-- Permissions Section -->
          <div class="form-group">
            <label class="form-label">
              <span>🔐</span> Privacy & Sharing Options
            </label>
            <div class="permissions-section">
              <!-- Encrypt Option -->
              <div class="permission-item">
                <input 
                  type="checkbox" 
                  name="encrypt" 
                  id="encrypt" 
                  class="form-checkbox"
                  <% if(hisaabData.encrypt){%> checked <%}%>
                />
                <div style="flex: 1;">
                  <label for="encrypt" class="form-label" style="margin: 0; font-weight: 500;">
                    🔒 Encrypt with Password
                  </label>
                  <p style="font-size: var(--font-size-sm); color: var(--text-secondary); margin-top: var(--spacing-1);">
                    Protect your hisaab with a secret code. Only those with the password can view the content.
                  </p>
                </div>
              </div>
              
              <div class="form-group" id="secret-code-group" style="<% if(!hisaabData.encrypt){%>display: none;<%}%> margin-top: var(--spacing-4);">
                <input
                  type="password"
                  name="secretCode"
                  id="secretCode"
                  class="form-input"
                  placeholder="Enter a strong secret code"
                  value="<% if(hisaabData.encrypt){%><%= hisaabData.secretCode %><%}%>"
                  <% if(!hisaabData.encrypt){%>disabled<%}%>
                />
              </div>

              <!-- Shareable Option -->
              <div class="permission-item">
                <input 
                  type="checkbox" 
                  name="shareable" 
                  id="shareable" 
                  class="form-checkbox"
                  <% if(hisaabData.isShare){%> checked <%}%>
                />
                <div style="flex: 1;">
                  <label for="shareable" class="form-label" style="margin: 0; font-weight: 500;">
                    🔗 Make Shareable
                  </label>
                  <p style="font-size: var(--font-size-sm); color: var(--text-secondary); margin-top: var(--spacing-1);">
                    Allow others to view this hisaab via a shareable link.
                  </p>
                </div>
              </div>

              <!-- Edit Permissions Option -->
              <div class="permission-item">
                <input 
                  type="checkbox" 
                  name="editable" 
                  id="editable" 
                  class="form-checkbox"
                  <% if(hisaabData.editPerms){%> checked <%}%>
                />
                <div style="flex: 1;">
                  <label for="editable" class="form-label" style="margin: 0; font-weight: 500;">
                    ✏️ Allow Editing
                  </label>
                  <p style="font-size: var(--font-size-sm); color: var(--text-secondary); margin-top: var(--spacing-1);">
                    Let others edit this hisaab when shared (requires shareable to be enabled).
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="flex gap-4" style="margin-top: var(--spacing-8);">
            <button type="submit" class="btn btn-primary btn-lg" style="flex: 1;">
              <span>💾</span> Update Hisaab
            </button>
            <a href="/show/<%= hisaabData.userId %>" class="btn btn-secondary btn-lg">
              <span>❌</span> Cancel
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script>
    // Enhanced form interactions
    const encryptCheckbox = document.getElementById("encrypt");
    const secretCodeInput = document.getElementById("secretCode");
    const secretCodeGroup = document.getElementById("secret-code-group");
    const shareableCheckbox = document.getElementById("shareable");
    const editableCheckbox = document.getElementById("editable");

    // Handle encrypt checkbox
    encryptCheckbox.addEventListener("change", () => {
      const isChecked = encryptCheckbox.checked;
      secretCodeInput.disabled = !isChecked;
      secretCodeGroup.style.display = isChecked ? "block" : "none";
      
      if (!isChecked) {
        secretCodeInput.value = "";
      } else {
        secretCodeInput.focus();
      }
    });

    // Handle editable checkbox dependency on shareable
    shareableCheckbox.addEventListener("change", () => {
      if (!shareableCheckbox.checked) {
        editableCheckbox.checked = false;
        editableCheckbox.disabled = true;
      } else {
        editableCheckbox.disabled = false;
      }
    });

    // Initialize editable state
    editableCheckbox.disabled = !shareableCheckbox.checked;

    // Form validation
    document.getElementById("update-form").addEventListener("submit", (e) => {
      const title = document.getElementById("title").value.trim();
      const hisaab = document.getElementById("hisaab").value.trim();
      
      if (!title || !hisaab) {
        e.preventDefault();
        alert("Please fill in both title and details fields.");
        return;
      }
      
      if (encryptCheckbox.checked && !secretCodeInput.value.trim()) {
        e.preventDefault();
        alert("Please enter a secret code for encryption.");
        secretCodeInput.focus();
        return;
      }
    });
  </script>
</body>
</html>
