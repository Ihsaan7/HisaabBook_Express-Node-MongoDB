<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Khaatabook</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-gray-800">
  <nav class="w-full py-4 px-6 flex items-center justify-between border-b border-gray-200">
    <h2 class="text-blue-500 text-xl font-semibold">Khaatabook</h2>
    <div class="flex gap-5 items-center text-blue-500">
      <a href="/">Home</a>
<a href="/create/<%= hisaabData.userId %>">Create New Hisaab</a>
    </div>
  </nav>

  <section class="p-6 max-w-3xl mx-auto">
    <h1 class="font-semibold text-xl text-blue-500 mb-4">Updating Hisaab of <% hisaabData.topic %></h1>
    <form action="/update/<%= hisaabData._id %>" method="post" class="flex flex-col gap-6 bg-white p-6 rounded-lg border border-gray-200 shadow-sm">
      
      <!-- Title Field -->
      <div>
        <label for="title" class="block text-sm font-medium text-blue-500 mb-1">Title</label>
        <input type="text" name="title" id="title" class="w-full p-2 rounded-md border border-gray-300 bg-white text-blue-500 placeholder-blue-300" placeholder="Enter topic or heading" value="<%= hisaabData.topic %>" />

      </div>

      <!-- Hisaab Textarea -->
      <div>
        <label for="hisaab" class="block text-sm font-medium text-blue-500 mb-1">Details</label>
        <textarea name="hisaab" id="hisaab" class="w-full h-40 p-2 rounded-md border border-gray-300 bg-white text-blue-500 placeholder-blue-300"><%= hisaabData.data %></textarea>

      </div>

      <!-- Permissions Section -->
      <fieldset class="flex flex-col gap-4">
        <legend class="text-sm font-semibold text-blue-500">Permissions</legend>

        <!-- Encrypt Option -->
        <div class="flex items-center gap-3">
          <input type="checkbox" name="encrypt" id="encrypt" class="w-4 h-4 text-blue-500 border-gray-300 rounded-sm focus:ring-blue-300" <% if(hisaabData.encrypt){%> checked <%}%> />
          <label for="encrypt" class="text-sm text-gray-700">Encrypt</label>

          <input
  type="text"
  name="secretCode"
  placeholder="Secret code"
  class="p-1 rounded-md border border-gray-300 bg-gray-100 disabled:bg-gray-100 text-sm text-blue-500 placeholder-blue-300"
  <% if(hisaabData.encrypt){%> value="<%= hisaabData.secretCode %>" <%}%>
/>

        </div>

        <!-- Shareable Option -->
        <div class="flex items-center gap-3">
          <input type="checkbox" name="shareable" id="shareable" class="w-4 h-4 text-blue-500 border-gray-300 rounded-sm focus:ring-blue-300" <% if(hisaabData.isShare){%> checked <%}%> />
          <label for="shareable" class="text-sm text-gray-700">Shareable</label>

        </div>

        <!-- Edit Permissions Option -->
        <div class="flex items-center gap-3">
          <input type="checkbox" name="editable" id="editable" class="w-4 h-4 text-blue-500 border-gray-300 rounded-sm focus:ring-blue-300" <% if(hisaabData.editPerms){%> checked <%}%> />
          <label for="editable" class="text-sm text-gray-700">Edit Permissions</label>

        </div>
      </fieldset>

      <!-- Submit Button -->
      <input type="submit" value="Submit" class="bg-blue-100 text-blue-600 px-6 py-2 rounded-md font-semibold hover:bg-blue-200 transition" />
    </form>
  </section>




  <script>
  const encryptCheckbox = document.getElementById("encrypt");
  const secretCodeInput = document.querySelector("input[name='secretCode']");

  // Set initial state based on checkbox
  secretCodeInput.disabled = !encryptCheckbox.checked;

  // Toggle input based on checkbox
  encryptCheckbox.addEventListener("change", () => {
    secretCodeInput.disabled = !encryptCheckbox.checked;
    if (!encryptCheckbox.checked) {
      secretCodeInput.value = '';
    }
  });
</script>

</body>
</html>
