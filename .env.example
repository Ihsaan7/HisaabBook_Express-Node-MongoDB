# Environment Variables for HisaabBook Application

# Port (automatically set by Vercel)
PORT=8000

# MongoDB Connection String
# Replace with your actual MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# Session Secret (REQUIRED - generate a secure random string)
# Use a strong, unique secret for production (minimum 32 characters)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_secure_session_secret_minimum_32_characters

# Node Environment
NODE_ENV=production