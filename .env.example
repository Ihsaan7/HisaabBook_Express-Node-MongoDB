# Environment Variables for HisaabBook Application

# Port (automatically set by Vercel)
PORT=8000

# MongoDB Connection String
# Replace with your actual MongoDB Atlas connection string
# MongoDB Connection URI (REQUIRED)
# Replace with your actual MongoDB connection string
MONGODB_URI=your_mongodb_connection_string_here

# JWT Secret (REQUIRED - generate a secure random string for JWT tokens)
# Use a strong, unique secret for JWT token signing (minimum 32 characters)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_jwt_secret_minimum_32_characters

# Node Environment
NODE_ENV=production